# Установлен инструментами флота (ADR-115 §8). Не править руками: bootstrap перезапишет.
[Unit]
Description=Флот: ограждение по поколению и heartbeat архива WAL (ADR-115 §8.4, §8.6)
Wants=docker.service network-online.target
After=docker.service network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/fleet-backup heartbeat
TimeoutStartSec=4min
Nice=0
IOSchedulingClass=best-effort
