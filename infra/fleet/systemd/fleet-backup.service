# Установлен инструментами флота (ADR-115 §8). Не править руками: bootstrap перезапишет.
[Unit]
Description=Флот: ночная полная копия и срок хранения (ADR-115 §8.3)
Wants=docker.service network-online.target
After=docker.service network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/fleet-backup nightly
TimeoutStartSec=6h
Nice=10
IOSchedulingClass=idle
